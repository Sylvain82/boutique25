<div class="col">
    <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge text-bg-secondary">{{ produit.type }}</span>
                {% if produit.promotion %}
                    <span class="badge text-bg-danger">Promo</span>
                {% endif %}
            </div>
            <h5 class="card-title">{{ produit.nom }}</h5>
            <p class="card-text text-body-secondary mb-3">{{ produit.marque }}</p>
            <p class="fs-4 fw-semibold mt-auto mb-0">{{ produit.prix|number_format(0, ',', ' ') }}&nbsp;€</p>
        </div>
    </div>
</div>
