<div class="col">
    <article class="produit">
        <div class="produit-photo">
            {% if produit.hasImage %}
                <img src="{{ path('app_produit_image', {id: produit.id, v: produit.imageMaj|date('U')}) }}" alt="{{ produit.nom }}" loading="lazy">
            {% else %}
                <span class="produit-photo-vide" aria-hidden="true">{{ produit.type|first|upper }}</span>
            {% endif %}
        </div>
        {% if produit.promotion %}<span class="produit-promo">Promo</span>{% endif %}
        <div class="produit-corps">
            <span class="produit-type">{{ produit.type }}</span>
            <h3 class="produit-nom">{{ produit.nom }}</h3>
            <div class="produit-marque">{{ produit.marque }}</div>
            <div class="produit-pied">
                <span class="produit-prix">{{ produit.prix|number_format(0, ',', ' ') }}&nbsp;€</span>
                <form method="post" action="{{ path('app_panier_ajouter', {id: produit.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                    <button class="btn btn-primary btn-ajouter" type="submit" title="Ajouter au panier" aria-label="Ajouter {{ produit.nom }} au panier">
                        {% include '_partials/icone.html.twig' with {nom: 'plus'} %}
                    </button>
                </form>
            </div>
        </div>
    </article>
</div>
