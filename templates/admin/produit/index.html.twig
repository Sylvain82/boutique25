{% extends 'admin/_layout.html.twig' %}

{% block admin %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">Produits</h1>
        <a class="btn btn-primary" href="{{ path('app_admin_produit_nouveau') }}">+ Ajouter un produit</a>
    </div>

    <form class="d-flex gap-2 mb-3" method="get">
        <input class="form-control" type="search" name="q" value="{{ q }}" placeholder="Nom ou marque" aria-label="Rechercher">
        <button class="btn btn-outline-secondary" type="submit">Rechercher</button>
    </form>

    {% if produits %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Nom</th>
                        <th scope="col">Marque</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-end">Prix</th>
                        <th scope="col">Promo</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for produit in produits %}
                        <tr>
                            <td>{{ produit.nom }}</td>
                            <td>{{ produit.marque }}</td>
                            <td>{{ produit.type }}</td>
                            <td class="text-end text-nowrap">{{ produit.prix|number_format(0, ',', ' ') }}&nbsp;€</td>
                            <td>{% if produit.promotion %}<span class="badge text-bg-danger">Promo</span>{% endif %}</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_produit_modifier', {id: produit.id}) }}">Modifier</a>
                                <form class="d-inline" method="post" action="{{ path('app_admin_produit_supprimer', {id: produit.id}) }}"
                                      onsubmit="return confirm('Supprimer « {{ produit.nom|e('js') }} » ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-produit' ~ produit.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-light border">Aucun produit.</div>
    {% endif %}
{% endblock %}
