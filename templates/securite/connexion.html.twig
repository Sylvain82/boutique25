{% extends 'base.html.twig' %}

{% block title %}Boutique — Connexion{% endblock %}

{% block content %}
    <div class="connexion-carte surface">
        <div class="text-center mb-4">
            <span class="marque-logo mb-3" aria-hidden="true">B</span>
            <h1 class="h3 mb-1">Connexion</h1>
            <p class="text-body-secondary mb-0">Espace réservé aux administrateurs de la boutique.</p>
        </div>

        {% if erreur %}
            <div class="alert alert-danger">
                {{ erreur.messageKey == 'Invalid credentials.' ? 'Email ou mot de passe incorrect.' : erreur.messageKey|trans(erreur.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_connexion') }}">
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input class="form-control" type="email" id="email" name="_username" value="{{ dernier_email }}" autocomplete="email" placeholder="vous@exemple.fr" required autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label" for="password">Mot de passe</label>
                <input class="form-control" type="password" id="password" name="_password" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="btn btn-degrade btn-lg w-100" type="submit">Se connecter</button>
        </form>

        <p class="text-center small text-body-secondary mt-4 mb-0">
            <a href="{{ path('app_home') }}">&larr; Retour à la boutique</a>
        </p>
    </div>
{% endblock %}
