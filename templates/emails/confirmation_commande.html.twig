<!doctype html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;color:#212529;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:8px;">
    <tr>
        <td style="padding:24px;">
            <h1 style="font-size:20px;margin:0 0 16px;">Merci {{ commande.nom }} !</h1>
            <p style="margin:0 0 16px;">
                Votre commande <strong>{{ commande.reference }}</strong> est confirmée
                (payée le {{ commande.payeeLe|date('d/m/Y à H:i', 'Europe/Paris') }}).
            </p>

            <table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
                <tr style="background:#f1f3f5;">
                    <th align="left">Produit</th>
                    <th align="center">Qté</th>
                    <th align="right">Sous-total</th>
                </tr>
                {% for ligne in commande.lignes %}
                    <tr style="border-bottom:1px solid #dee2e6;">
                        <td>{{ ligne.nomProduit }}</td>
                        <td align="center">{{ ligne.quantite }}</td>
                        <td align="right" style="white-space:nowrap;">{{ ligne.sousTotal|number_format(0, ',', ' ') }}&nbsp;€</td>
                    </tr>
                {% endfor %}
                <tr>
                    <td colspan="2" align="right"><strong>Total</strong></td>
                    <td align="right" style="white-space:nowrap;"><strong>{{ commande.total|number_format(0, ',', ' ') }}&nbsp;€</strong></td>
                </tr>
            </table>

            <p style="margin:16px 0 0;font-size:14px;">
                <strong>Livraison :</strong><br>
                {{ commande.nom }}<br>
                {{ commande.adresse }}<br>
                {{ commande.codePostal }} {{ commande.ville }}
            </p>
            {% if commande.modePaiement == 'simulation' %}
                <p style="margin:16px 0 0;font-size:12px;color:#6c757d;">Paiement simulé : boutique de démonstration, aucun montant n'a été prélevé.</p>
            {% endif %}
        </td>
    </tr>
</table>
</body>
</html>
