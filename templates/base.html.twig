<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Boutique{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    {% block stylesheets %}
        <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
    {% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Boutique</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Afficher le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            {% set route = app.request.attributes.get('_route') %}
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <a class="nav-link{{ route == 'app_home' ? ' active' }}" href="{{ path('app_home') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link{{ route == 'app_produits' ? ' active' }}" href="{{ path('app_produits') }}">Produits</a>
                </li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link{{ route starts with 'app_admin' ? ' active' }}" href="{{ path('app_admin') }}">Administration</a>
                    </li>
                {% endif %}
            </ul>
            {% set nbPanier = panier_nombre() %}
            <a class="btn btn-outline-light me-md-3 mb-2 mb-md-0{{ route starts with 'app_panier' ? ' active' }}" href="{{ path('app_panier') }}">
                Panier
                {% if nbPanier > 0 %}<span class="badge text-bg-warning ms-1">{{ nbPanier }}</span>{% endif %}
            </a>
            <form class="d-flex" role="search" action="{{ path('app_produits') }}" method="get">
                <input class="form-control me-2" type="search" name="q" placeholder="Rechercher un produit" aria-label="Rechercher">
                <button class="btn btn-outline-success" type="submit">Rechercher</button>
            </form>
        </div>
    </div>
</nav>

<main class="container">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block content %}{% endblock %}
</main>

<footer class="container text-center text-body-secondary small my-5">
    Boutique — projet de démonstration
    ·
    {% if app.user %}
        <a class="link-secondary" href="{{ path('app_deconnexion') }}">Se déconnecter</a>
    {% else %}
        <a class="link-secondary" href="{{ path('app_connexion') }}">Espace administrateur</a>
    {% endif %}
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
